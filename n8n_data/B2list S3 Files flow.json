    {
      "parameters": {
        "executeOnce": false,
        "command": "=#!/bin/bash\nset -e\n\n# Extraímos o ID do binário vindo do n8n\nBINARY_ID=\"{{ $binary.data.id }}\"\n\n# Removemos o prefixo 'filesystem-v2:' para obter a trilha lógica\nLOGICAL_PATH=$(echo $BINARY_ID | sed 's/filesystem-v2://')\n\n# Montamos o caminho absoluto incluindo a pasta 'storage'\nREAL_PATH=\"/root/.n8n/storage/${LOGICAL_PATH}\"\n\nFILENAME=\"{{ $json.name }}\"\n\n# Validação de existência antes do processamento\nif [ ! -f \"$REAL_PATH\" ]; then\n    echo \"❌ Erro: Arquivo não encontrado em $REAL_PATH\"\n    exit 1\nfi\n\n# --- Geração e Encapsulamento do Checksum MD5 ---\nMD5_VALUE=$(md5sum \"$REAL_PATH\" | awk '{ print $1 }')\necho \"MD5_CHECK_RESULT:¶$MD5_VALUE¶\"\n# -----------------------------------------------\n\necho \"🚀 Transmitindo de: $REAL_PATH\"\n\n# Upload via AWS CLI v1 (Supabase Storage)\naws s3 cp \"$REAL_PATH\" \"s3://b2list/${FILENAME}\" \\\n  --endpoint-url \"${SUPABASE_S3_ENDPOINT}\" \\\n  --content-type \"text/csv\"\n\necho \"✅ Sucesso: ${FILENAME} transferido.\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        752,
        96
