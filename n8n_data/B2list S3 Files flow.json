    {
      "parameters": {
        "executeOnce": false,
        "command": "=#!/bin/bash\nset -e\n\n# Extraímos o ID do binário vindo do n8n\nBINARY_ID=\"{{ $binary.data.id }}\"\n\n# Removemos o prefixo 'filesystem-v2:' para obter a trilha lógica\n# Ex: workflows/167.../executions/47/binary_data/fcea...\nLOGICAL_PATH=$(echo $BINARY_ID | sed 's/filesystem-v2://')\n\n# Montamos o caminho absoluto incluindo a pasta 'storage' identificada\nREAL_PATH=\"/root/.n8n/storage/${LOGICAL_PATH}\"\n\nFILENAME=\"{{ $json.name }}\"\n\necho \"🚀 Transmitindo de: $REAL_PATH\"\n\n# Validação de existência antes do upload\nif [ ! -f \"$REAL_PATH\" ]; then\n    echo \"❌ Erro: Arquivo não encontrado em $REAL_PATH\"\n    echo \"🔍 Conteúdo de /root/.n8n/storage: \"\n    ls -R /root/.n8n/storage | head -n 20\n    exit 1\nfi\n\n# Upload via AWS CLI v1 (Supabase Storage)\naws s3 cp \"$REAL_PATH\" \"s3://b2list/${FILENAME}\" \\\n  --endpoint-url \"${SUPABASE_S3_ENDPOINT}\" \\\n  --content-type \"text/csv\"\n\necho \"✅ Sucesso: ${FILENAME} transferido diretamente do filesystem.\""
      },
