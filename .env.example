N8N_BASIC_AUTH_USER=user-do-admin-n8n
N8N_BASIC_AUTH_PASSWORD=sua-senha-de-acesso-ao-n8n
AWS_ACCESS_KEY_ID=sua-access-key-ao-bucket-aws
AWS_SECRET_ACCESS_KEY=sua-secret-access-key-ao-bucket-aws
AWS_DEFAULT_REGION=sua-region-ao-bucket-aws-ex-sa-east-1
SUPABASE_S3_ENDPOINT=https://[url-sua-instacia-aws-compativel]/storage/v1/s3
AWS_S3_ADDRESSING_STYLE=path

SFTP_HOST=[ip-do-host-sftp]
SFTP_PORT=[port-do-host-sftp]
SFTP_USER=[user-do-host-sftp]
SFTP_PASS=[pwd-do-host-sftp]

DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_HOST=[host-postgres-supabase-transaction-pooler]
DB_POSTGRESDB_PASSWORD=[db-password-configurado-no-supabase]
DB_POSTGRESDB_PORT=6543
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_USER=postgres.[instancia_do_supabase]
DB_TYPE=postgresdb

N8N_BLOCK_SVC_COMMAND_EXECUTION=false
N8N_ENABLE_UNSAFE_CORE_NODES=TRUE
N8N_ENCRYPTION_KEY=[encryption-key-segura-com-min-32-caracteres]
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
N8N_EXECUTE_COMMAND_ENABLED=TRUE
N8N_NODES_EXCLUDE=[]
NODE_OPTIONS="--dns-result-order=ipv4first"
PORT=5678
